<!-- <%= debug @blogPosts %> -->
<!-- Blogs Posts Index Page -->

<div class="flex-between">
  <h1>Blogs</h1>

  <% if authenticated? %>
    <% if params[:mine] == "true" %>
      <%= link_to "Show All Blogs", blog_posts_path %>
    <% else %>
      <%= link_to "Show My Blogs", blog_posts_path(mine: true) %>
    <% end %>
  <% end %>
</div>

<%= tag.div(flash[:notice], style: "color:green") if flash[:notice] %>

<% post_count = @blogPosts.length %>
<div id="blogs" class="<%= class_names(
  "populated" => post_count.positive?,
  "count-#{post_count}" => post_count.between?(1, 3)
) %>">

  <% if post_count > 0 %>
    <% @blogPosts.each do |blog| %>
      <a href="/blog_posts/<%= blog.id %>" class="blog-post-tile">

        <div>
          <h2 class="title"><%= blog.title %></h2>
          <p class="timestamp">
            <% if blog.updated_at > blog.created_at %>
              Updated <%= time_ago_in_words(blog.updated_at) %> ago
            <% else %>
              Posted <%= time_ago_in_words(blog.created_at) %> ago
            <% end %>
          </p>
        </div>
    
        <%# truncate the body to 200 characters %>
        <p class="body"><%= truncate(blog.body, length: 200) %></p>
      </a>
    <% end %>
  <% else %>

    <% if authenticated? %>
      <p>You have not posted any blogs!</p>
      <%= link_to "Create New Blog", new_blog_post_path %>
    <% else %>
      <p>This blog has no posts yet, <%= link_to "Sign Up", sign_up_path %> and be the first to write one!</p>
    <% end %>
    
  <% end %>
</div>
